# MQTT Configuration
# This part is used to configure the MQTT broker connection for ALL services.
MQTT_BROKER_URL=mosquitto               # or 'iti-mqtt.mni.thm.de' if using the public broker
MQTT_BROKER_PORT=9001                   # or '1883' depending on your configuration; beware that the web-controller need WebSocket access, so try sticking to '9001'
MQTT_USERNAME=test                      # replace with your MQTT username - can be found in your repository in ./mqtt_credentials.txt
MQTT_PASSWORD=test1234                  # replace with your MQTT password - can be found in your repository in ./mqtt_credentials.txt
MQTT_MESSAGE_PREFIX=${MQTT_USERNAME}/   # automatically uses your MQTT username as prefix for all topic messages (your_mqtt_username/...)

# Database Configuration
# This part is used to configure the database connection for the java-backend service.
DB_USER=user
DB_PASSWORD=userpassword
DB_ROOT_PASSWORD=rootpassword
DB_NAME=quiz_game
DB_HOST=mariadb
DB_PORT=3306
